{
	"$schema": "https://json.schemastore.org/tsconfig.json",
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"checkJs": true,
		"declaration": true,
		"incremental": true,
		"isolatedModules": true,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"outDir": "output",
		"rootDir": "source",
		"skipLibCheck": true,
		"sourceMap": true,
		"target": "esnext",
		"tsBuildInfoFile": "output/tsconfig.tsbuildinfo",
		"types": ["node"]
	},
	"include": ["@types", "source"]
}
